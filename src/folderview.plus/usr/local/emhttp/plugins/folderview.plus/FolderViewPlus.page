<h2 data-fv-section="auto-assignment" data-fv-advanced="1" data-fv-advanced-group="rules">Auto-assignment rules</h2>
<div class="rules-bottom-grid fv-rules-grid">
    <div class="rules-panel fv-rules-source-panel">
        <div class="rules-header">
            <h3>Rules workspace</h3>
            <span class="rules-help">Choose Docker or VMs, then create, order, and review automatic folder rules in one place.</span>
        </div>
        <div class="fv-rules-source-switch" role="tablist" aria-label="Rules source switcher">
            <button type="button" class="fv-rules-source-btn" data-fv-rules-source-toggle="docker" data-fv-onclick="setRulesWorkspaceType('docker')"><i class="fa fa-cubes"></i> Docker</button>
            <button type="button" class="fv-rules-source-btn" data-fv-rules-source-toggle="vm" data-fv-onclick="setRulesWorkspaceType('vm')"><i class="fa fa-desktop"></i> VMs</button>
        </div>
    </div>

    <div class="rules-panel fv-rules-workspace" data-fv-rules-type="docker">
        <div class="rules-header">
            <h3>Docker rules</h3>
            <span class="rules-help">Set the priority order that decides where new containers go.</span>
        </div>
        <div class="fv-rules-overview">
            <div class="fv-rules-overview-copy">
                <span id="docker-rules-status" class="fv-rules-status-chip">No rules yet</span>
                <strong id="docker-rules-headline" class="fv-rules-headline">No Docker rules yet.</strong>
                <p id="docker-rules-detail" class="fv-rules-detail">Create your first rule to automatically sort new containers into the right folder.</p>
            </div>
            <div class="fv-rules-stat-grid">
                <div class="fv-rules-stat-card">
                    <span class="fv-rules-stat-label">Total</span>
                    <strong id="docker-rules-total" class="fv-rules-stat-value">0</strong>
                </div>
                <div class="fv-rules-stat-card">
                    <span class="fv-rules-stat-label">Active</span>
                    <strong id="docker-rules-active" class="fv-rules-stat-value">0</strong>
                </div>
                <div class="fv-rules-stat-card">
                    <span class="fv-rules-stat-label">Exclude</span>
                    <strong id="docker-rules-exclude" class="fv-rules-stat-value">0</strong>
                </div>
                <div class="fv-rules-stat-card">
                    <span class="fv-rules-stat-label">Folders</span>
                    <strong id="docker-rules-folders" class="fv-rules-stat-value">0</strong>
                </div>
            </div>
            <div id="docker-rules-issues" class="fv-rules-issue-row" hidden></div>
        </div>
        <div class="fv-rule-stage">
            <div class="fv-rule-stage-head">
                <strong>1. Create rule</strong>
                <span>Describe what should match, whether it should include or exclude, and which folder should win.</span>
            </div>
            <div class="fv-rule-builder-grid">
                <div class="fv-rule-builder-field">
                    <label for="docker-rule-folder">Then place it in</label>
                    <select id="docker-rule-folder"></select>
                </div>
                <div class="fv-rule-builder-field">
                    <label for="docker-rule-effect">Rule effect</label>
                    <select id="docker-rule-effect">
                        <option value="include">Include</option>
                        <option value="exclude">Exclude</option>
                    </select>
                </div>
                <div class="fv-rule-builder-field">
                    <label for="docker-rule-kind">When this field</label>
                    <select id="docker-rule-kind" data-fv-onchange="toggleRuleKindFields('docker')">
                        <option value="name_contains">Name contains</option>
                        <option value="name_starts_with">Name starts with</option>
                        <option value="image_contains">Image contains</option>
                        <option value="compose_project_equals">Compose project equals</option>
                        <option value="name_regex">Name regex</option>
                        <option value="label">Label equals</option>
                        <option value="label_contains">Label contains</option>
                        <option value="label_starts_with">Label starts with</option>
                        <option value="image_regex">Image regex</option>
                        <option value="compose_project_regex">Compose project regex</option>
                    </select>
                </div>
                <div class="fv-rule-builder-field fv-rule-builder-field-wide">
                    <label for="docker-rule-pattern">Match value</label>
                    <input id="docker-rule-pattern" type="text" placeholder="Regex pattern (example: ^media-)">
                </div>
                <div class="fv-rule-builder-field">
                    <label for="docker-rule-label-key">Label key</label>
                    <input id="docker-rule-label-key" type="text" placeholder="Label key (example: com.example.stack)" style="display:none;">
                </div>
                <div class="fv-rule-builder-field">
                    <label for="docker-rule-label-value">Label value</label>
                    <input id="docker-rule-label-value" type="text" placeholder="Label value (optional, blank means any value)" style="display:none;">
                </div>
            </div>
            <div class="fv-rule-builder-actions">
                <button type="button" class="rules-add-btn" data-fv-onclick="addAutoRule('docker')"><i class="fa fa-plus"></i> Add Docker rule</button>
            </div>
        </div>
        <div class="fv-rule-stage">
            <div class="fv-rule-stage-head">
                <strong>2. Smart suggestions</strong>
                <span>Scan current containers and existing folders for safe rule ideas before saving anything.</span>
            </div>
            <div class="fv-rule-test-actions">
                <button type="button" data-fv-onclick="scanSmartRuleSuggestions('docker')"><i class="fa fa-magic"></i> Scan Docker suggestions</button>
                <button type="button" data-fv-onclick="saveSelectedSmartRuleSuggestions('docker')"><i class="fa fa-check"></i> Save selected suggestions</button>
            </div>
            <div id="docker-rule-suggestions" class="fv-rule-suggestion-list">Scan Docker suggestions to see rule ideas.</div>
        </div>
        <div class="fv-rule-stage">
            <div class="fv-rule-stage-head">
                <strong>3. Review rule order</strong>
                <span>Rules run from top to bottom. The first matching include or exclude rule decides what happens.</span>
            </div>
            <div class="fv-rule-toolbar">
                <input id="docker-rules-filter" type="text" placeholder="Search Docker rules" data-fv-oninput="setFilterQuery('rules','docker',this.value)">
                <div class="fv-rule-selection-actions">
                    <button type="button" data-fv-onclick="toggleAllRuleSelections('docker', true)"><i class="fa fa-check-square-o"></i> Select all shown</button>
                    <button type="button" data-fv-onclick="toggleAllRuleSelections('docker', false)"><i class="fa fa-square-o"></i> Clear selection</button>
                    <button type="button" data-fv-onclick="bulkRuleAction('docker','enable')"><i class="fa fa-eye"></i> Enable</button>
                    <button type="button" data-fv-onclick="bulkRuleAction('docker','disable')"><i class="fa fa-eye-slash"></i> Disable</button>
                    <button type="button" data-fv-onclick="bulkRuleAction('docker','delete')"><i class="fa fa-trash"></i> Delete</button>
                    <button type="button" data-fv-onclick="bulkRuleAction('docker','export')"><i class="fa fa-download"></i> Export</button>
                </div>
            </div>
            <div id="docker-rules-selection-summary" class="fv-rule-selection-summary">No Docker rules selected.</div>
            <div id="docker-rules" class="fv-rule-list" role="list" aria-label="Docker auto-assignment rules"></div>
        </div>
    </div>

    <div class="rules-panel fv-rules-workspace" data-fv-rules-type="vm" hidden>
        <div class="rules-header">
            <h3>VM rules</h3>
            <span class="rules-help">Set the priority order that decides where new VMs go.</span>
        </div>
        <div class="fv-rules-overview">
            <div class="fv-rules-overview-copy">
                <span id="vm-rules-status" class="fv-rules-status-chip">No rules yet</span>
                <strong id="vm-rules-headline" class="fv-rules-headline">No VM rules yet.</strong>
                <p id="vm-rules-detail" class="fv-rules-detail">Create your first rule to automatically sort new VMs into the right folder.</p>
            </div>
            <div class="fv-rules-stat-grid">
                <div class="fv-rules-stat-card">
                    <span class="fv-rules-stat-label">Total</span>
                    <strong id="vm-rules-total" class="fv-rules-stat-value">0</strong>
                </div>
                <div class="fv-rules-stat-card">
                    <span class="fv-rules-stat-label">Active</span>
                    <strong id="vm-rules-active" class="fv-rules-stat-value">0</strong>
                </div>
                <div class="fv-rules-stat-card">
                    <span class="fv-rules-stat-label">Exclude</span>
                    <strong id="vm-rules-exclude" class="fv-rules-stat-value">0</strong>
                </div>
                <div class="fv-rules-stat-card">
                    <span class="fv-rules-stat-label">Folders</span>
                    <strong id="vm-rules-folders" class="fv-rules-stat-value">0</strong>
                </div>
            </div>
            <div id="vm-rules-issues" class="fv-rules-issue-row" hidden></div>
        </div>
        <div class="fv-rule-stage">
            <div class="fv-rule-stage-head">
                <strong>1. Create rule</strong>
                <span>Describe which VM names should match and where those matches should go.</span>
            </div>
            <div class="fv-rule-builder-grid">
                <div class="fv-rule-builder-field">
                    <label for="vm-rule-folder">Then place it in</label>
                    <select id="vm-rule-folder"></select>
                </div>
                <div class="fv-rule-builder-field">
                    <label for="vm-rule-effect">Rule effect</label>
                    <select id="vm-rule-effect">
                        <option value="include">Include</option>
                        <option value="exclude">Exclude</option>
                    </select>
                </div>
                <div class="fv-rule-builder-field">
                    <label for="vm-rule-kind">When this field</label>
                    <select id="vm-rule-kind" data-fv-onchange="toggleRuleKindFields('vm')">
                        <option value="name_contains">Name contains</option>
                        <option value="name_starts_with">Name starts with</option>
                        <option value="name_regex">Name regex</option>
                    </select>
                </div>
                <div class="fv-rule-builder-field fv-rule-builder-field-wide">
                    <label for="vm-rule-pattern">Match value</label>
                    <input id="vm-rule-pattern" type="text" placeholder="Regex pattern (example: ^prod-)">
                </div>
            </div>
            <div class="fv-rule-builder-actions">
                <button type="button" class="rules-add-btn" data-fv-onclick="addAutoRule('vm')"><i class="fa fa-plus"></i> Add VM rule</button>
            </div>
        </div>
