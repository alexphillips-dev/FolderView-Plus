            backup_count=0
            custom_icon_count=0
            override_count=0
            if [ -f "${config_dir}/version" ] || [ -f "${config_dir}/docker.json" ] || [ -f "${config_dir}/vm.json" ] || [ -f "${config_dir}/docker.prefs.json" ] || [ -f "${config_dir}/vm.prefs.json" ] || [ -d "${config_dir}/backups" ] || [ -d "${config_dir}/images/custom" ] || [ -d "${config_dir}/styles" ] || [ -d "${config_dir}/scripts" ]; then
                had_config=1
            fi
            if [ -f "${config_dir}/version" ]; then
                previous_version="$(cat "${config_dir}/version" | tr -cd '0-9.')"
            fi
            if [ -d "${config_dir}/backups" ]; then
                backup_count="$(find "${config_dir}/backups" -type f | wc -l | tr -d '[:space:]')"
            fi
            if [ -d "${config_dir}/images/custom" ]; then
                custom_icon_count="$(find "${config_dir}/images/custom" -type f | wc -l | tr -d '[:space:]')"
            fi
            if [ -d "${config_dir}/styles" ]; then
                override_count="$(find "${config_dir}/styles" -type f | wc -l | tr -d '[:space:]')"
            fi
            if [ -d "${config_dir}/scripts" ]; then
                script_override_count="$(find "${config_dir}/scripts" -type f | wc -l | tr -d '[:space:]')"
                override_count="$((override_count + script_override_count))"
            fi
            {
                printf 'started_at=%s\n' "$(date +%s)"
                printf 'previous_version=%s\n' "${previous_version}"
                printf 'had_config=%s\n' "${had_config}"
                printf 'backup_count=%s\n' "${backup_count}"
                printf 'custom_icon_count=%s\n' "${custom_icon_count}"
                printf 'override_count=%s\n' "${override_count}"
            } > "${install_context}"
            rm -f "${icon_status}"
        </INLINE>
    </FILE>

    <FILE Name="/boot/config/plugins/&name;/folderview.plus-icons-&iconPackVersion;.txz">
        <URL>&iconPackURL;</URL>
        <MD5>&iconPackMd5;</MD5>
        <SHA256>&iconPackSha256;</SHA256>
    </FILE>

    <FILE Name="/boot/config/plugins/&name;/&name;-&version;.txz" Run="upgradepkg --install-new">
        <URL>https://raw.githubusercontent.com/&github;/dev/archive/&name;-&version;.txz</URL>
        <MD5>&md5;</MD5>
        <SHA256>&sha256;</SHA256>
    </FILE>

    <FILE Run="/bin/bash">
        <INLINE>
            set -e
            install_stage="configuration"
            install_report="&plugdir;/scripts/install_report.sh"
            icon_status="/tmp/folderview.plus-icon-pack-status"
            scheduler_status="registered"
            install_failure() {
                exit_code=$?
                trap - EXIT
                if [ -f "${install_report}" ]; then
                    /bin/bash "${install_report}" failure "&version;" "&iconPackVersion;" "${icon_status}" "${install_stage}" "${exit_code}" || true
                fi
                exit "${exit_code}"
            }
            trap install_failure EXIT
            mkdir -p /boot/config/plugins/&name;/styles
            mkdir -p /boot/config/plugins/&name;/scripts
            find /boot/config/plugins/&name; -maxdepth 1 -type f -name '&name;-[0-9]*.txz' ! -name '&name;-&version;.txz' -delete
            install_stage="obsolete runtime cleanup"
            rm -f "&plugdir;/scripts/folderviewplus.native-organizer.js" "&plugdir;/scripts/docker.member-menu.js"
            install_stage="icon pack activation"
            FVPLUS_ICON_PACK_STATUS_FILE="${icon_status}" /bin/bash "&plugdir;/scripts/install_icon_asset_pack.sh" "&iconPackVersion;" "&iconPackSha256;"
            install_stage="scheduled backup registration"
            echo "*/5 * * * * root /usr/local/bin/php /usr/local/emhttp/plugins/folderview.plus/scripts/scheduled_backup.php >/dev/null 2>&amp;1" > /etc/cron.d/folderview.plus
            chmod 644 /etc/cron.d/folderview.plus
            if ! /etc/rc.d/rc.crond restart >/dev/null 2>&amp;1; then
                scheduler_status="registered-restart-warning"
            fi
            install_stage="version metadata"
            echo "&version;" > /boot/config/plugins/&name;/version
            install_stage="installation report"
            /bin/bash "${install_report}" complete "&version;" "&iconPackVersion;" "${icon_status}" "${scheduler_status}"
            trap - EXIT
        </INLINE>
    </FILE>

    <FILE Run="/bin/bash" Method="remove">
        <INLINE>
            removepkg &name;-&version; || true
            rm -f /etc/cron.d/folderview.plus
            /etc/rc.d/rc.crond restart >/dev/null 2>&amp;1 || true
            rm -rf &plugdir;
            rm -rf /tmp/folderview.plus-assets
            rm -rf /boot/config/plugins/&name;
        </INLINE>
    </FILE>

</PLUGIN>
