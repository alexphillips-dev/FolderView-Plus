<script>
    window.FolderViewPlusHostThemeName = <?php echo json_encode((string)($display['theme'] ?? ''), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE); ?>;
    (function applySettingsHostThemeName(rawThemeName) {
        const safeThemeName = String(rawThemeName || '').trim().toLowerCase();
        if (!safeThemeName) {
            return;
        }
        const applyAttrs = () => {
            try {
                document.documentElement?.setAttribute('data-fvplus-host-theme', safeThemeName);
                document.documentElement?.setAttribute('data-fv-host-theme', safeThemeName);
                document.body?.setAttribute('data-fvplus-host-theme', safeThemeName);
                document.body?.setAttribute('data-fv-host-theme', safeThemeName);
            } catch (_error) {
                // Best effort only.
            }
        };
        applyAttrs();
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', applyAttrs, { once: true });
        }
    })(window.FolderViewPlusHostThemeName);
</script>

