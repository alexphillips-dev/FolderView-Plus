                                </dd>
                            </dl>
                            <blockquote class="inline_help">
                                <p data-i18n="[html]context-graph-tooltip">
                                    Which graph to show.
                                </p>
                            </blockquote>
                        </div>
                    </li>
                    <li constraint="context_graph-1 context_graph-2 context_graph-3 context_graph-4 docker">
                        <div class="basic">
                            <dl>
                                <dt data-i18n="context-graph-time">Time Frame (s):</dt>
                                <dd>
                                    <img class="img" style="visibility: hidden;">
                                    <input type="number" name="context_graph_time" value="60">
                                </dd>
                            </dl>
                            <blockquote class="inline_help">
                                <p data-i18n="[html]context-graph-time-tooltip">
                                    Time frame for the graph(s) in seconds.
                                </p>
                            </blockquote>
                        </div>
                    </li>
                </ul>
            </li>
        </ul>

        <div class="basic">
            <dl>
                <dt>Folder status colors:</dt>
                <dd class="folder-status-colors-dd">
                    <div class="fv-inline-control-row">
                        <div class="folder-status-colors">
                            <label class="folder-status-color-item">
                                <span>Started</span>
                                <input type="color" name="status_color_started" style="height:28px;vertical-align:middle;">
                            </label>
                            <label class="folder-status-color-item">
                                <span>Paused</span>
                                <input type="color" name="status_color_paused" style="height:28px;vertical-align:middle;">
                            </label>
                            <label class="folder-status-color-item">
                                <span>Stopped</span>
                                <input type="color" name="status_color_stopped" style="height:28px;vertical-align:middle;">
                            </label>
                        </div>
                        <button type="button" class="fv-inline-reset-btn" onclick="event.preventDefault(); resetStatusColorDefaults();">
                            <i class="fa fa-repeat" aria-hidden="true"></i>
                        </button>
                    </div>
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p>
                    Set custom colors for this folder's status icon and text across Docker, VMs, and Dashboard views.
                    <br>
                    The <i class="fa fa-repeat" aria-hidden="true"></i> button resets to defaults.
                </p>
            </blockquote>
        </div>

        <div class="basic">
            <dl>
                <dt>Accent color:</dt>
                <dd class="fv-accent-color-dd">
                    <input class="basic-switch" name="folder_accent_enabled" type="checkbox" style="display: none;" onchange="updateForm()" />
                    <div class="fv-accent-inline-controls" constraint="accent-color" style="display: none;">
                        <span class="fv-accent-inline-label">Bar color</span>
                        <div class="fv-inline-control-row">
                            <input type="color" name="folder_accent_color" style="height:28px;vertical-align:middle;">
                            <button type="button" class="fv-inline-reset-btn" onclick="event.preventDefault(); resetFolderAccentDefaults();">
                                <i class="fa fa-repeat" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p>
                    Adds an optional accent bar on the left side of this folder across Docker, VMs, Dashboard, and the editor preview.
                    <br>
                    Disabled by default so the folder keeps the standard appearance until you turn it on, then choose the bar color here.
                </p>
            </blockquote>
        </div>

        <div class="basic" constraint="docker">
            <dl>
                <dt>Health warn threshold (%):</dt>
                <dd>
                    <img class="img" style="visibility: hidden;">
                    <input type="number" name="health_warn_stopped_percent" min="0" max="100" step="1" placeholder="Use global threshold">
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p>
                    Optional per-folder override for the stopped percentage warning threshold used in the Health column.
                    <br>
                    Leave blank to use the global Docker Health threshold.
                </p>
            </blockquote>
        </div>

        <div class="basic" constraint="docker">
            <dl>
                <dt>Health critical threshold (%):</dt>
                <dd>
                    <img class="img" style="visibility: hidden;">
                    <input type="number" name="health_critical_stopped_percent" min="0" max="100" step="1" placeholder="Use global/profile threshold">
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p>
                    Optional per-folder override for the stopped percentage critical threshold in health scoring.
                    <br>
                    Leave blank to use the current health profile/global setting.
                </p>
            </blockquote>
        </div>

        <div class="basic" constraint="docker">
            <dl>
                <dt>Health profile:</dt>
                <dd>
                    <img class="img" style="visibility: hidden;">
                    <select name="health_profile">
                        <option value="" selected>Use global profile</option>
                        <option value="strict">Strict</option>
                        <option value="balanced">Balanced</option>
                        <option value="lenient">Lenient</option>
                    </select>
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p>
                    Optional per-folder profile preset for health scoring and thresholds.
                </p>
            </blockquote>
        </div>

        <div class="basic" constraint="docker">
            <dl>
                <dt>Health updates mode:</dt>
                <dd>
                    <img class="img" style="visibility: hidden;">
                    <select name="health_updates_mode">
                        <option value="" selected>Use global mode</option>
                        <option value="maintenance">Maintenance</option>
                        <option value="warn">Warn</option>
                        <option value="ignore">Ignore</option>
                    </select>
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p>
                    Controls how pending updates affect this folder’s health.
                </p>
            </blockquote>
        </div>

        <div class="basic" constraint="docker">
            <dl>
                <dt>Health all-stopped mode:</dt>
                <dd>
                    <img class="img" style="visibility: hidden;">
                    <select name="health_all_stopped_mode">
                        <option value="" selected>Use global mode</option>
                        <option value="critical">Critical</option>
                        <option value="warn">Warn</option>
                    </select>
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p>
                    Controls how an all-stopped folder is classified.
                </p>
            </blockquote>
        </div>

        <div class="basic">
            <dl>
                <dt>Status warn threshold (%):</dt>
                <dd>
                    <img class="img" style="visibility: hidden;">
                    <input type="number" name="status_warn_stopped_percent" min="0" max="100" step="1" placeholder="Use global threshold">
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p>
                    Optional per-folder override for the stopped percentage warning threshold used by the Status chip accent.
                    <br>
                    Leave blank to use the global Status threshold.
                </p>
            </blockquote>
        </div>

        <div class="basic" constraint="docker">
            <dl>
                <dt data-i18n="update-column">Hide update column:</dt>
                <dd>
                    <input class="basic-switch" name="update_column" type="checkbox" style="display: none;" />
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p data-i18n="[html]update-column-tooltip">
                    Will <b>NUKE</b> the update column for this folder.
                </p>
            </blockquote>
        </div>
        <div class="basic">
            <dl>
                <dt data-i18n="override-default-actions">Override default actions:</dt>
                <dd>
                    <input class="basic-switch" name="override_default_actions" type="checkbox" style="display: none;" />
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p data-i18n="[html]override-default-actions-tooltip">
                    Will remove the default menu and replace it with the custom actions set below.
                </p>
            </blockquote>
        </div>
        <div class="basic">
            <dl>
                <dt data-i18n="default-action">Hide default action button:</dt>
                <dd>
                    <input class="basic-switch" name="default_action" type="checkbox" style="display: none;" />
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p data-i18n="[html]default-action-tooltip">
                    Will remove the default action button like start, stop and restart from the folder context menu.
                </p>
            </blockquote>
        </div>
        <div class="basic">
            <dl>
                <dt data-i18n="expand-tab">Expanded on Docker/VM tab:</dt>
                <dd>
                    <input class="basic-switch" name="expand_tab" type="checkbox" style="display: none;" />
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p data-i18n="[html]expand-tab-tooltip">
                    Will make the folder start expanded on the Docker/VMs tab.
                </p>
            </blockquote>
        </div>
        <div class="basic">
            <dl>
                <dt data-i18n="expand-dashboard">Expanded on Dashboard tab:</dt>
                <dd>
                    <input class="basic-switch" name="expand_dashboard" type="checkbox" style="display: none;" />
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p data-i18n="[html]expand-dashboard-tooltip">
                    Will make the folder start expanded on the Dashboard.
                </p>
            </blockquote>
        </div>
        <div class="basic">
            <dl>
                <dt>Dashboard overflow mode:</dt>
                <dd>
                    <select name="dashboard_overflow">
                        <option value="default">Default</option>
                        <option value="expand_row">Expand row</option>
                        <option value="scroll">Scrollable panel</option>
                    </select>
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p>
                    Controls how expanded dashboard members are shown for this folder.
                </p>
            </blockquote>
        </div>
        <div class="basic">
            <dl>
                <dt data-i18n="regex">Regex:</dt>
                <dd>
                    <input type="text" name="regex" oninput="updateRegex(this)" value="">
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p data-i18n="[html]regex-tooltip">
                    Optional automation rule for this folder.
                    <br>
                    Matching container or VM names will be auto-included here.
                    <br>
                    Example for matching a Pterodactyl egg ID: <b>[0-9a-zA-Z]{8}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{4}-[0-9a-zA-Z]{12}</b>.
                    <br>
                    Editing this field will replace manual member selections with the current regex matches.
                </p>
            </blockquote>
        </div>
        <div class="basic custom-action-wrapper-parent">
            <dl>
                <dt data-i18n="custom-actions-folder">Custom actions:</dt>
                <dd>
                    <div class="custom-action-wrapper">​</div>
                </dd>
            </dl>
            <blockquote class="inline_help">
                <span data-i18n="[html]custom-actions-folder-tooltip">
                    Add optional actions to this folder menu.
                    <br><b>Standard</b> actions control selected containers or VMs directly.
                    <br><b>Custom</b> actions run a User Scripts task if that plugin is installed.
                    <br>Use the action list below to edit, remove, and reorder what appears for this folder.
                </span>
            </blockquote>
        </div>
        <div class="basic">
            <dl>
                <dt>​</dt>
                <dd>
                    <a class="custom-action" data-i18n="[html]custom-action" onclick="customAction()"><i class="fa fa-plus" aria-hidden="true"></i> Add a custom action</a>
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p data-i18n="[html]custom-action-tooltip">
                    Opens the action editor for a new folder action.
                </p>
            </blockquote>
        </div>
        <input class="folder-btn-submit" type="submit" value="Submit" data-i18n="[value]submit">
        <input class="folder-btn-apply-settings" type="button" value="Apply to folders..." onclick="applyFolderSettingsToFolders(); return false;">
        <input class="folder-btn-copy" type="button" value="Save as copy" onclick="submitForm(this.form, true); return false;">
        <input class="folder-btn-reset" type="button" value="Reset unsaved changes" onclick="resetUnsavedChanges(); return false;">
        <input class="folder-btn-cancel" type="button" value="Cancel" data-i18n="[value]cancel" onclick="cancelBtn()">
        <span id="unsavedIndicator" class="folder-unsaved-indicator" style="display:none;">Unsaved changes</span>
        <div class="basic order-section">
            <dl>
                <dt data-i18n="order">Order:</dt>
                <dd>
                    <table class="sortable">
                        <thead>
                            <tr>
                                <th>
                                    Order
                                </th>
                                <th data-i18n="table-name">
                                    Name
                                </th>
                                <th data-i18n="table-included">
                                    Included
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </dd>
            </dl>
            <blockquote class="inline_help">
                <p data-i18n="[html]order-tooltip">
                    Use the up/down buttons to set your desired order. Regex-selected entries are auto-included and locked.
                </p>
            </blockquote>
        </div>
    </form>
</div>


<div class="dialogCustomAction" style="display:none"></div>

<div class="templateDialogCustomAction" style="display: none;">
    <div>
        <dl>
            <dt data-i18n="name">Name:</dt>
            <dd>
                <input type="text" name="action_name">
            </dd>
        </dl>
    </div>
    <div>
        <dl>
            <dt data-i18n="custom-actions-type">Type:</dt>
            <dd>
                <select name="action_type" onchange="((el) => {$('[constraint*=\'action-type-\']').hide(); $(`[constraint*=\'action-type-${el.value}\']`).show();})(this)">
                    <option value="0" data-i18n="custom-actions-type-0">Standard</option>
                    <option value="1" data-i18n="custom-actions-type-1">Custom</option>
                </select>
            </dd>
        </dl>
    </div>
    <div class="standard" constraint="action-type-0">
        <div>
            <dl>
                <dt data-i18n="custom-actions-action">Action:</dt>
                <dd>
                    <select name="action_standard" onchange="((el) => {$('[constraint*=\'action-standard-\']').hide(); $(`[constraint*=\'action-standard-${el.value}\']`).show();})(this)">
                        <option value="0" data-i18n="custom-actions-action-0">Cycle</option>
                        <option value="1" data-i18n="custom-actions-action-1">Set</option>
                        <option value="2" data-i18n="custom-actions-action-2">Restart</option>
                    </select>
                </dd>
            </dl>
        </div>
        <div class="cycle" constraint="action-standard-0">
            <dl>
                <dt data-i18n="custom-actions-states">States:</dt>
                <dd>
                    <select name="action_cycle">
                        <option value="0" data-i18n="custom-actions-cycle-0">Start - stop</option>
                        <option value="1" data-i18n="custom-actions-cycle-1">Pause - resume</option>
                    </select>
                </dd>
            </dl>
        </div>
        <div class="set" style="display: none;" constraint="action-standard-1">
            <dl>
                <dt data-i18n="custom-actions-states">States:</dt>
                <dd>
                    <select name="action_set">
                        <option value="0" data-i18n="custom-actions-set-0">Start</option>
                        <option value="1" data-i18n="custom-actions-set-1">Stop</option>
                        <option value="2" data-i18n="custom-actions-set-2">Pause</option>
                        <option value="3" data-i18n="custom-actions-set-3">Resume</option>
                    </select>
                </dd>
            </dl>
        </div>
        <div class="action-subject">
            <dl>
                <dt data-i18n="custom-actions-cts">Containers:</dt>
                <dd>
                    <select name="action_elements" multiple></select>
                </dd>
            </dl>
        </div>
    </div>
    <div class="custom" style="display: none;" constraint="action-type-1">
        <dl>
            <dt data-i18n="custom-actions-script">Script:</dt>
            <dd>
                <input type="text" name="action_script">
            </dd>
        </dl>
        <dl>
            <dt data-i18n="custom-actions-arguments">Arguments:</dt>
            <dd>
                <input type="text" name="action_script_args">
            </dd>
        </dl>
        <dl>
            <dt data-i18n="custom-actions-script-sync">Sync:</dt>
            <dd>
            <input class="basic-switch-sync" name="action_script_sync" type="checkbox" style="display: none;" />
            </dd>
        </dl>
    </div>
    <dl>
        <dt data-i18n="icon">Icon:</dt>
        <dd>
            <input type="text" name="action_script_icon">
        </dd>
    </dl>
</div>
