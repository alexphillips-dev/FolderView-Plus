}
try {
    $folderEditorPageType = ensureType((string)($_GET['type'] ?? $_REQUEST['type'] ?? $folderEditorCookieType ?? ''));
    $folderEditorTypePrefs = readTypePrefs($folderEditorPageType);
    $folderEditorTypePrefs['_metadata'] = readConfigMetadata($folderEditorPageType, true);
    $folderEditorRequestedId = trim((string)(
        $_GET['id']
        ?? $_REQUEST['id']
        ?? $_GET['folderId']
        ?? $_REQUEST['folderId']
        ?? $_GET['folder']
        ?? $_REQUEST['folder']
        ?? $_GET['name']
        ?? $_REQUEST['name']
        ?? $folderEditorCookieId
        ?? ''
    ));
    if ($folderEditorRequestedId !== '') {
        $folderEditorBootstrapContext = resolveFolderEditorRequestedContext($folderEditorPageType, $folderEditorRequestedId);
        $folderEditorResolvedId = trim((string)($folderEditorBootstrapContext['resolvedId'] ?? ''));
    }
    $folderEditorBootstrapContext['metadata'] = readConfigMetadata($folderEditorPageType, true);
} catch (Throwable $folderEditorPageError) {
    $folderEditorPageType = '';
    $folderEditorPageMode = 'modern';
    $folderEditorPageModeSource = 'modern-only';
    $folderEditorRequestedId = '';
    $folderEditorResolvedId = '';
    $folderEditorTypePrefs = [];
    $folderEditorBootstrapContext = [
        'requestedId' => '',
        'resolvedId' => '',
        'resolvedBy' => '',
        'folder' => null,
        'metadata' => null
    ];
}
